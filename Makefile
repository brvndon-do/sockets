CXX := clang++
CXXFLAGS := -std=c++23 -Wall -Wextra -g -MMD -MP
BUILD := build

all: $(BUILD)/server $(BUILD)/client $(BUILD)/showip

$(BUILD)/server: $(BUILD)/server.o $(BUILD)/network.o
	$(CXX) $(CXXFLAGS) $^ -o $@

$(BUILD)/client: $(BUILD)/client.o $(BUILD)/network.o
	$(CXX) $(CXXFLAGS) $^ -o $@

# showip is standalone
$(BUILD)/showip: $(BUILD)/showip.o
	$(CXX) $(CXXFLAGS) $^ -o $@

# order-only prerequisite (after |): build/ must exist, but its timestamp
# changing doesn't force rebuilds
$(BUILD)/%.o: %.cpp | $(BUILD)
	$(CXX) $(CXXFLAGS) -c $< -o $@

$(BUILD):
	mkdir -p $@

clean:
	rm -rf $(BUILD)

.PHONY: all clean

# header dependencies generated by -MMD (rebuilds .o when a header changes)
-include $(wildcard $(BUILD)/*.d)
